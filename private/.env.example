# Copy to private/.env and fill in. Never commit the real .env.

# Public site URL, no trailing slash. Used in emails and by the cron scripts.
BASE_URL=https://wedding.example.com

# Database
DB_HOST=localhost
DB_NAME=wedding
DB_USER=wedding_user
DB_PASS=

# SMTP (e.g. Resend: user "resend", password = API key)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
# A sender on a verified domain; SMTP_VERIFIED_DOMAIN builds noreply@<domain> instead
SMTP_FROM_EMAIL=
SMTP_VERIFIED_DOMAIN=
# Defaults to the couple names from site content
SMTP_FROM_NAME=

# Fallback notification recipients. The active ones are set in the admin
# Site Content page; these are used only when those fields are blank.
RSVP_EMAIL=
CONTACT_EMAIL=

# Admin passwords
ADMIN_PASSWORD=
RSVP_CHECK_PASSWORD=
REGISTRY_ADMIN_PASSWORD=
REHEARSAL_SEATING_PASSWORD=

# Registry purchase notification recipients (comma-separated)
REGISTRY_PURCHASE_NOTIFY=

# Cloudflare Turnstile (registry purchase bot protection)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cron: registry low-stock checker
REGISTRY_LOW_AVAILABLE_THRESHOLD=10
REGISTRY_CHECK_COOLDOWN_HOURS=24
REGISTRY_CHECK_RECIPIENTS=
REGISTRY_CHECK_DRY_RUN=

# Cron: site uptime checker (SITE_CHECK_URL defaults to BASE_URL)
SITE_CHECK_URL=
SITE_CHECK_TIMEOUT_SECONDS=15
SITE_CHECK_COOLDOWN_MINUTES=30
SITE_CHECK_RECIPIENTS=
SITE_CHECK_DRY_RUN=
