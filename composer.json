{
    "license": "MIT",
    "name": "jacobstephens2/wedding-platform",
    "description": "Self-hosted wedding website: RSVPs, registry, story, gallery, and seating",
    "require": {
        "php": ">=8.3",
        "vlucas/phpdotenv": "^5.5",
        "phpmailer/phpmailer": "^6.9",
        "erusev/parsedown": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Wedding\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "phpstan/phpstan": "^2"
    },
    "autoload-dev": {
        "psr-4": {
            "Wedding\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "platform": {
            "php": "8.3.6"
        }
    }
}
